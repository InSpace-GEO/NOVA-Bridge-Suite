          "pattern": "^[0-9a-f]{64}$"
        },
        "monthly_strategy_item_id": {
          "type": "string"
        },
        "upload_date": {
          "type": "string",
          "format": "date-time"
        },
        "schedule_id": {
          "type": "string",
          "nullable": true
        },
        "schedule_status": {
